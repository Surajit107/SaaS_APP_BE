# Copy to `.env` and adjust values. `.env.sample` mirrors this with safe dev defaults filled in.
# Never commit `.env`.

PORT=3000

# Local MongoDB URI (replace with mongodb+srv://... when using Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/saas_app

# Access JWT signing (minimum ~32 chars; rotate in production)
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Seed platform owner: `npm run seed:platform-admin` (user has empty tenantId, no org row)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Soft-delete retention before MongoDB TTL hard-delete (milliseconds). Default ~30 days if omitted.
TENANT_PURGE_AFTER_MS=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudinary (direct upload + metadata persistence)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Temporary upload expiry window in minutes (5-180, default 30)
FILE_TEMP_TTL_MINUTES=30

# Frontend public URL used for billing + email action links
FRONTEND_BASE_URL=http://localhost:5173
# CORS allowlist (comma-separated origins, no quotes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://lovely-direct-magpie.ngrok-free.app

# Product name in email From header, subjects ("Brand — …"), and templates (default: Asteriq.in)
PLATFORM_BRAND_NAME=Asteriq.in

# Resend (https://resend.com) — verify your domain or use Resend’s test sender in dev
RESEND_API_KEY=
# No-reply mailbox only (`noreply@your-verified-domain.com`; optional legacy `Name <noreply@...>` — address is parsed)
RESEND_FROM_EMAIL=noreply@your-verified-domain.com
# Optional hosted logo URL for email header (preferred over inline base64 to avoid Gmail clipping)
EMAIL_LOGO_URL=

# AI assistant (tenant chatbot — Pro/Enterprise; optional plan.features.aiChatbot in catalog)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CHATBOT_PROVIDER_ORDER=openrouter,groq,gemini
CHATBOT_MODEL_OPENROUTER=openai/gpt-4o-mini
CHATBOT_MODEL_GROQ=llama-3.3-70b-versatile
CHATBOT_MODEL_GEMINI=gemini-2.0-flash
# CHATBOT_SYSTEM_PROMPT=
CHATBOT_UPSTREAM_TIMEOUT_MS=55000
OPENROUTER_HTTP_REFERER=http://localhost:5173
OPENROUTER_APP_TITLE=SaaS Application
